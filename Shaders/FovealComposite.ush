// Parabellum - фовеальный композит. Тело Custom-ноды Post Process Material,
// вставляется скриптом Tools/make_vision_material.py. Работает в SceneColorBeforeBloom.
//
// Входы ноды (все скаляры - VectorParameter приходит в Custom как float3, .w нет):
//   UV (ViewportUV), SceneTex (регистрирует PostProcessInput0), SideL, SideR (Texture2D),
//   Aspect, CenterFOV, SideYaw, SideFOV, TotalFOV, PaniniD, CamPitch, PitchAlignStart, PitchAlignEnd,
//   SideExposureFix, SideMip, BlendStart, BlendEnd, BlurStartYaw, BlurMaxDeg, Debug.
// Debug: 1/2 - левый/правый RT сырой, 3 - только центр, 4 - композит с тонировкой источников, 5 - отношение яркости бок/центр
//        (левый бок красноватый, правый зеленоватый, центр как есть) - для поиска швов и рассинхрона.
// Кадр камеры: x вправо, y вверх, z вперёд. Экран: u вправо, v вниз.
//
// Проекция (v4, Панини): x = sN*(d+1)*sin(yaw)/(d+cos(yaw)),  y = sN*tan(pitch)*(d+1)/(d+cos(yaw)).
// Одна гладкая функция без зон: вертикали прямые (x зависит только от yaw), вертикальный масштаб растёт
// к краям монотонно (горба нет), горизонтали - мягкие дуги как у широкоугольного объектива.
// sN выбирается так, что кромка экрана = TotalFOV/2. PaniniD: 1 - классический Панини, больше - ближе
// к цилиндрической ортографике (сильнее сжимает края, вмещает больше). При 135/5 центр = 97% плотности CS 90.
// Обратная функция (депроекция выстрела, Э8): xp = x/sN; R = sqrt((d+1)^2+xp^2); a = atan2(xp, d+1);
//   yaw = a + asin(xp*d/R);  S = (d+1)/(d+cos(yaw));  pitch = atan((y/aspect)/(sN*S)).
// Ось проекции привязана к вертикали МИРА, а не камеры: yaw считается вокруг мирового "вверх", pitch на
// экране - относительно направления взгляда. Иначе при наклоне головы горизонт складывается чашей.
// При |CamPitch| > PitchAlignStart ось плавно переходит к камерной (к PitchAlignEnd полностью) - у зенита
// мировая ось вырождается.
// Отвергнутые версии: v1 гипербола от оси (центр гнулся), v2 рект. центр + цилиндр (ряды гнулись),
// v3 рект. центр + сжатая периферия (горб/гребень на границе зон - неизбежен при двух режимах).

const float PI = 3.14159265f;
const float D2R = PI / 180.0f;

float aspect = max(Aspect, 0.1f);

float centerFov = CenterFOV * D2R;
float sideYaw   = SideYaw * D2R;
float sideFov   = SideFOV * D2R;
float tanHc = tan(centerFov * 0.5f);
float tanVc = tanHc / aspect;
float tanS  = tan(sideFov * 0.5f);

// --- отладочные виды ---
if (Debug > 0.5f && Debug < 1.5f) return Texture2DSampleLevel(SideL, SideLSampler, UV, SideMip).rgb / max(EyeAdaptationLookup(), 1e-6f);
if (Debug > 1.5f && Debug < 2.5f) return Texture2DSampleLevel(SideR, SideRSampler, UV, SideMip).rgb / max(EyeAdaptationLookup(), 1e-6f);
if (Debug > 2.5f && Debug < 3.5f) return SceneTextureLookup(UV, 14, false).rgb;

// --- Режим 1: три плоские панели (как три монитора симрейсера). Центр - чистая перспектива с плотностью
//     CS (PanelScale=1), боковые - камеры, повёрнутые на SideYaw, той же плотности. На стыке разрыв, без искажений.
if (Mode > 0.5f)
{
	float xn1 = UV.x * 2.0f - 1.0f;
	float yn1 = 1.0f - UV.y * 2.0f;
	float kx = tan(CSHalfH * D2R) / max(PanelCenterFrac, 0.05f) / max(PanelScale, 0.1f); // tan(угол) на единицу xn
	float tanHc1 = tan(CenterFOV * 0.5f * D2R);
	float tanVc1 = tanHc1 / aspect;
	float tanS1  = tan(SideFOV * 0.5f * D2R);
	float ax1 = abs(xn1);
	float sgn1 = (xn1 >= 0.0f) ? 1.0f : -1.0f;
	float tp = (yn1 / aspect) * kx;                                                     // tan(pitch) общий
	if (ax1 <= PanelCenterFrac)
	{
		float tx = xn1 * kx;
		float2 uvc1 = float2(0.5f + 0.5f * tx / tanHc1, 0.5f - 0.5f * tp / tanVc1);
		float inC1 = all(abs(uvc1 - 0.5f) <= 0.5f) ? 1.0f : 0.0f;
		return lerp(float3(0.02f, 0.02f, 0.02f), SceneTextureLookup(saturate(uvc1), 14, false).rgb, inC1);
	}
	float hp = (1.0f - PanelCenterFrac) * 0.5f;
	float xl = (ax1 - PanelCenterFrac - hp);                                             // -hp..hp внутри панели
	if (abs(xl) > hp - PanelSeparator) return float3(0.0f, 0.0f, 0.0f);                 // разделитель
	float txs = xl * kx;                                                                 // tan(угол от оси боковой камеры)
	float2 uvs1 = float2(0.5f + 0.5f * sgn1 * txs / tanS1, 0.5f - 0.5f * tp / tanS1);
	float inS1 = all(abs(uvs1 - 0.5f) <= 0.5f) ? 1.0f : 0.0f;
	float3 cs1 = (sgn1 > 0.0f) ? Texture2DSampleLevel(SideR, SideRSampler, saturate(uvs1), 0).rgb
	                           : Texture2DSampleLevel(SideL, SideLSampler, saturate(uvs1), 0).rgb;
	cs1 *= lerp(1.0f, 1.0f / max(EyeAdaptationLookup(), 1e-6f), SideExposureFix);
	return lerp(float3(0.02f, 0.02f, 0.02f), cs1, inS1);
}

// --- экран -> (yaw, pitch), Панини ---
float xn = UV.x * 2.0f - 1.0f;
float yn = 1.0f - UV.y * 2.0f;
float d  = max(PaniniD, 0.01f);
float e  = clamp(TotalFOV * 0.5f, 10.0f, 89.9f) * D2R;
float sN = (d + cos(e)) / ((d + 1.0f) * sin(e));      // кромка экрана = e
float xp = xn / sN;
float R  = sqrt((d + 1.0f) * (d + 1.0f) + xp * xp);
float al = atan2(xp, d + 1.0f);
float yaw = al + asin(clamp(xp * d / R, -1.0f, 1.0f));
float S  = (d + 1.0f) / (d + cos(yaw));
float pitch = atan((yn / aspect) / (sN * S));      // относительно направления взгляда

// Эффективный наклон системы координат проекции: до PitchAlignStart - полностью мировая ось,
// к PitchAlignEnd - полностью камерная.
float p0  = CamPitch * D2R;
float p0e = p0 * (1.0f - smoothstep(PitchAlignStart, PitchAlignEnd, abs(CamPitch)));
float cP = cos(p0e), sP = sin(p0e);

float ayawDeg = abs(yaw) / D2R;
float blurDeg = BlurMaxDeg * smoothstep(BlurStartYaw, 90.0f, ayawDeg);

// --- сбор цвета: центральный тап + 8 по кольцу радиусом blurDeg (в градусах угла) ---
float3 acc = 0.0f;
float  wsum = 0.0f;
[unroll]
for (int i = 0; i < 9; i++)
{
	float tapW = (i == 0) ? 1.0f : (blurDeg > 0.01f ? 1.0f : 0.0f);
	float a = (float)i * (PI / 4.0f);
	float2 off = (i == 0) ? float2(0, 0) : blurDeg * float2(cos(a), sin(a)) * D2R;
	float yw = yaw + off.x;
	float pf = p0e + pitch + off.y;                    // pitch в системе проекции
	float cp = cos(pf), sp = sin(pf);
	float3 df = float3(sin(yw) * cp, sp, cos(yw) * cp); // направление в системе проекции
	// в систему камеры (камера смотрит вверх на p0e внутри системы проекции)
	float3 d = float3(df.x, df.y * cP - df.z * sP, df.y * sP + df.z * cP);

	float wSide = smoothstep(BlendStart, BlendEnd, abs(yw) / D2R);

	// центр (ректилинейно в центральную камеру)
	float2 c = float2(d.x, d.y) / max(d.z, 1e-4f) / float2(tanHc, tanVc);
	// Мягкий край кадра: вес затухает на последних ~8% поля, чтобы граница центр/бок не была ступенькой.
	float inC = (d.z > 0.0f) ? smoothstep(1.0f, 0.92f, max(abs(c.x), abs(c.y))) : 0.0f;
	float2 uvc = saturate(float2(0.5f + 0.5f * c.x, 0.5f - 0.5f * c.y));
	float3 colC = SceneTextureLookup(uvc, 14, false).rgb;

	// бок: в системе проекции поворот на -+sideYaw вокруг её вертикали, затем в кадр боковой камеры
	// (она смотрит вверх на p0e внутри повёрнутой системы) - зеркально UPBLVisionComponent::UpdateSideRotation.
	float sgn = (yw >= 0.0f) ? 1.0f : -1.0f;
	float cy = cos(sideYaw), sy = sin(sideYaw);
	float3 d1 = float3(df.x * cy - sgn * df.z * sy, df.y, sgn * df.x * sy + df.z * cy);
	float3 ds = float3(d1.x, d1.y * cP - d1.z * sP, d1.y * sP + d1.z * cP);
	float2 s = float2(ds.x, ds.y) / max(ds.z, 1e-4f) / tanS;
	float inS = (ds.z > 0.0f) ? smoothstep(1.0f, 0.92f, max(abs(s.x), abs(s.y))) : 0.0f;
	float2 uvs = saturate(float2(0.5f + 0.5f * s.x, 0.5f - 0.5f * s.y));
	// Мип бокового RT = периферийное размытие и подавление алиасинга захвата (у RT включены мипы):
	// 0.5 у шва (стык остаётся резким) -> SideMip у кромки экрана.
	// по полному углу от направления взгляда: вниз/вверх бока тоже периферия
	float offAxisDeg = acos(clamp(d.z, -1.0f, 1.0f)) / D2R;
	float mip = lerp(0.5f, SideMip, smoothstep(BlendStart, BlendEnd + 10.0f, offAxisDeg));   // полный мип уже к ~60 град
	float3 colS = (sgn > 0.0f) ? Texture2DSampleLevel(SideR, SideRSampler, uvs, mip).rgb
	                           : Texture2DSampleLevel(SideL, SideLSampler, uvs, mip).rgb;
	// Бока захвачены как FinalColorHDR (с экспозицией и TAA), центр здесь ещё до экспозиции - возвращаем.
	colS *= lerp(1.0f, 1.0f / max(EyeAdaptationLookup(), 1e-6f), SideExposureFix);
	if (Debug > 3.5f)
	{
		colS *= (sgn > 0.0f) ? float3(0.5f, 1.0f, 0.5f) : float3(1.0f, 0.5f, 0.5f);
	}

	// Веса по зоне смешивания, но если один источник направление не покрывает -
	// второй берётся целиком вне зависимости от зоны (верх/низ вне центра, края).
	// Debug 5: отношение яркости бок/центр там, где покрывают оба. 0.5 серый = равны, светлее = бок ярче.
	if (Debug > 4.5f)
	{
		float lc = dot(colC, float3(0.3f, 0.59f, 0.11f));
		float ls = dot(colS, float3(0.3f, 0.59f, 0.11f));
		float both = inC * inS;
		float ratio = (lc > 1e-5f) ? ls / lc : 1.0f;
		acc  += (both > 0.0f ? float3(0.5f, 0.5f, 0.5f) * ratio : float3(0.0f, 0.0f, 0.15f)) * tapW;
		wsum += tapW;
		continue;
	}

	float wC = inC * max(1.0f - wSide, 1.0f - inS);
	float wS = inS * max(wSide, 1.0f - inC);
	float have = wC + wS;
	float3 col = (have > 0.0f) ? (colC * wC + colS * wS) / have : float3(0, 0, 0);
	float ok = (have > 0.0f) ? 1.0f : 0.0f;

	acc  += col * tapW * ok;
	wsum += tapW * ok;
}

return (wsum > 0.0f) ? acc / wsum : float3(0.01f, 0.01f, 0.01f);
