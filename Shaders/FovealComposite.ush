// Parabellum - фовеальный композит. Тело Custom-ноды Post Process Material,
// вставляется скриптом Tools/make_vision_material.py. Работает в SceneColorBeforeBloom.
//
// Входы ноды (все скаляры - VectorParameter приходит в Custom как float3, .w нет):
//   UV (ViewportUV), SceneTex (регистрирует PostProcessInput0), SideL, SideR (Texture2D),
//   Aspect, CenterFOV, SideYaw, SideFOV, RectYaw, RectWidth, EdgeYaw, PitchCap, VertCompress, VertBlendDeg,
//   BlendStart, BlendEnd, BlurStartYaw, BlurMaxDeg, Debug.
// Debug: 1/2 - левый/правый RT сырой, 3 - только центр, 4 - композит с тонировкой источников
//        (левый бок красноватый, правый зеленоватый, центр как есть) - для поиска швов и рассинхрона.
// Кадр камеры: x вправо, y вверх, z вперёд. Экран: u вправо, v вниз.
//
// Проекция (v3): центральные +-RectYaw - настоящая перспектива (равномерно отмасштабированный кроп
// центрального кадра, ни одного искажения; 35 град / 0.70 = CS FOV 90). Дальше yaw сжимается гиперболой
// до EdgeYaw у кромки со стыковкой по наклону (C1). Вертикаль: в центре y = tan(pitch)/cos(yaw)*sx
// (перспектива), на периферии масштаб столбца G = Gc*(F'(yaw)/F'(RectYaw))^VertCompress - вертикаль сжата
// как корень из горизонтального (VertCompress 0.5), с плавным входом за VertBlendDeg. Вертикали прямые везде.
// PitchCap ограничивает, как высоко смотрит кромка (боковые камеры должны это покрывать).
// Обратная функция (депроекция выстрела, Э8):
//   |x| <= RectWidth : yaw = atan(x / sx),  sx = RectWidth / tan(RectYaw)
//   иначе            : xp = (|x|-RectWidth)/A * U/(U+tau);  yaw = RectYaw + tau*xp/(1-xp)
//   A = 1-RectWidth, U = EdgeYaw-RectYaw, k1 = sx/cos^2(RectYaw), tau = A*U/(k1*U - A)
//   pitch = atan((y/aspect) / G(yaw)),  G = sx/cos(yaw) в центре, иначе A*tau/(u+tau)^2*(U+tau)/U*cos(RectYaw)

const float PI = 3.14159265f;
const float D2R = PI / 180.0f;

float aspect = max(Aspect, 0.1f);

float centerFov = CenterFOV * D2R;
float sideYaw   = SideYaw * D2R;
float sideFov   = SideFOV * D2R;
float tanHc = tan(centerFov * 0.5f);
float tanVc = tanHc / aspect;
float tanS  = tan(sideFov * 0.5f);

// --- отладочные виды ---
if (Debug > 0.5f && Debug < 1.5f) return Texture2DSampleLevel(SideL, SideLSampler, UV, 0).rgb;
if (Debug > 1.5f && Debug < 2.5f) return Texture2DSampleLevel(SideR, SideRSampler, UV, 0).rgb;
if (Debug > 2.5f && Debug < 3.5f) return SceneTextureLookup(UV, 14, false).rgb;

// --- экран -> (yaw, pitch) ---
float xn = UV.x * 2.0f - 1.0f;
float yn = 1.0f - UV.y * 2.0f;
float thetaC = RectYaw * D2R;
float sx  = RectWidth / tan(thetaC);                  // tan(yaw) -> доля полуширины
float U   = max(EdgeYaw * D2R - thetaC, 0.01f);        // угол, укладываемый в остаток ширины
float A   = 1.0f - RectWidth;
float k1  = sx / (cos(thetaC) * cos(thetaC));         // dx/dyaw на границе, на радиан
float tau = A * U / max(k1 * U - A, 1e-3f);
float ax = abs(xn);
float yawAbs, G;
if (ax <= RectWidth)
{
	yawAbs = atan(ax / sx);
	G = sx / cos(yawAbs);                              // перспектива: кроп центрального кадра
}
else
{
	float xp = min((ax - RectWidth) / A * (U / (U + tau)), 0.999f);
	float u  = tau * xp / (1.0f - xp);
	yawAbs = thetaC + u;
	float Fp = A * tau / ((u + tau) * (u + tau)) * ((U + tau) / U);
	// Вертикальное сжатие - степень VertCompress от горизонтального (1 = изотропно, 0 = без сжатия;
	// 0.5 - компромисс: у кромки предметы не тонкие и не схлопнутые). Переход от перспективного
	// масштаба к сжатому размазан на VertBlendDeg, иначе на границе гребень (наклоны разные).
	float Gc   = sx / cos(thetaC);
	float Gsq  = Gc * pow(max(Fp / k1, 1e-4f), VertCompress);
	float Gper = sx / cos(min(yawAbs, 1.4f));
	G = lerp(Gper, Gsq, smoothstep(0.0f, VertBlendDeg * D2R, u));
}
G = max(G, (1.0f / aspect) / tan(PitchCap * D2R));    // кромка не смотрит выше PitchCap
float yaw   = (xn >= 0.0f ? 1.0f : -1.0f) * yawAbs;
float pitch = atan((yn / aspect) / G);

float ayawDeg = abs(yaw) / D2R;
float blurDeg = BlurMaxDeg * smoothstep(BlurStartYaw, 90.0f, ayawDeg);

// --- сбор цвета: центральный тап + 8 по кольцу радиусом blurDeg (в градусах угла) ---
float3 acc = 0.0f;
float  wsum = 0.0f;
[unroll]
for (int i = 0; i < 9; i++)
{
	float tapW = (i == 0) ? 1.0f : (blurDeg > 0.01f ? 1.0f : 0.0f);
	float a = (float)i * (PI / 4.0f);
	float2 off = (i == 0) ? float2(0, 0) : blurDeg * float2(cos(a), sin(a)) * D2R;
	float yw = yaw + off.x;
	float pt = pitch + off.y;
	float cp = cos(pt), sp = sin(pt);
	float3 d = float3(sin(yw) * cp, sp, cos(yw) * cp);

	float wSide = smoothstep(BlendStart, BlendEnd, abs(yw) / D2R);

	// центр (ректилинейно в центральную камеру)
	float2 c = float2(d.x, d.y) / max(d.z, 1e-4f) / float2(tanHc, tanVc);
	// Мягкий край кадра: вес затухает на последних ~8% поля, чтобы граница центр/бок не была ступенькой.
	float inC = (d.z > 0.0f) ? smoothstep(1.0f, 0.92f, max(abs(c.x), abs(c.y))) : 0.0f;
	float2 uvc = saturate(float2(0.5f + 0.5f * c.x, 0.5f - 0.5f * c.y));
	float3 colC = SceneTextureLookup(uvc, 14, false).rgb;

	// бок (поворот на -+sideYaw вокруг вертикали камеры)
	float sgn = (yw >= 0.0f) ? 1.0f : -1.0f;
	float cy = cos(sideYaw), sy = sin(sideYaw);
	float3 ds = float3(d.x * cy - sgn * d.z * sy, d.y, sgn * d.x * sy + d.z * cy);
	float2 s = float2(ds.x, ds.y) / max(ds.z, 1e-4f) / tanS;
	float inS = (ds.z > 0.0f) ? smoothstep(1.0f, 0.92f, max(abs(s.x), abs(s.y))) : 0.0f;
	float2 uvs = saturate(float2(0.5f + 0.5f * s.x, 0.5f - 0.5f * s.y));
	float3 colS = (sgn > 0.0f) ? Texture2DSampleLevel(SideR, SideRSampler, uvs, 0).rgb
	                           : Texture2DSampleLevel(SideL, SideLSampler, uvs, 0).rgb;
	if (Debug > 3.5f)
	{
		colS *= (sgn > 0.0f) ? float3(0.5f, 1.0f, 0.5f) : float3(1.0f, 0.5f, 0.5f);
	}

	// Веса по зоне смешивания, но если один источник направление не покрывает -
	// второй берётся целиком вне зависимости от зоны (верх/низ вне центра, края).
	float wC = inC * max(1.0f - wSide, 1.0f - inS);
	float wS = inS * max(wSide, 1.0f - inC);
	float have = wC + wS;
	float3 col = (have > 0.0f) ? (colC * wC + colS * wS) / have : float3(0, 0, 0);
	float ok = (have > 0.0f) ? 1.0f : 0.0f;

	acc  += col * tapW * ok;
	wsum += tapW * ok;
}

return (wsum > 0.0f) ? acc / wsum : float3(0.01f, 0.01f, 0.01f);
